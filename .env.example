# Публичный URL обработчика формы в Yandex Cloud Functions.
FORM_ENDPOINT=https://functions.yandexcloud.net/<function-id>

# Публичный ключ сайта из hCaptcha.
HCAPTCHA_SITEKEY=<public-hcaptcha-sitekey>

# Базовый URL опубликованного сайта. Для GitHub Pages проекта оставьте путь репозитория.
SITE_URL=https://drmonro.github.io/lp-stroyrem

# URL YML-фида каталога для production-сборки.
CATALOG_YML_URL=<catalog-feed-url>
