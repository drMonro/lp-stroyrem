<section class="section-teaser section-overlay">
  <div class="section-teaser__content">
    <div class="utp">
      <div class="utp-composition">
        <p class="utp-composition__header">
          <span class="utp-composition__header-text">Магазин</span>
        </p>
        <div class="utp-composition__header-title">
          Строитлеьных отделочных
          <br />
          материалов
        </div>
        <span class="utp-composition__header-sub-title">
          <svg><use xlink:href='media/sprite/sprite.svg#truck'></use></svg>
          <span>Доставка по всему городу</span>
          <svg><use xlink:href='media/sprite/sprite.svg#truck'></use></svg>
        </span>
      </div>

      <p class="utp-composition__description">
        <span>СтройРемонт24</span>
        — ваш надёжный магазин строительных материалов для ремонта любого уровня сложности.
        В нашем ассортименте — только востребованные и качественные материалы от проверенных производителей.
      </p>

      {% set buttonModifier = "button--store" %}
      {% set hidePhone = true %}
      {% include "partials/purchase-actions.njk" %}
      {% set buttonModifier = "" %}
      {% set hidePhone = false %}
    </div>

  </div>

  <div class="teaser-footer">
      <a href="#contacts" class="teaser-footer__location">
        <svg>
          <use xlink:href='media/sprite/sprite.svg#location'></use>
        </svg>
        г. Красноярск, Северное ш., 5А, корп. 3, пом. 4
      </a>
      {% include "partials/phone.njk" %}

      <div class="teaser-footer__schedule">
        <svg><use xlink:href='media/sprite/sprite.svg#clock'></use></svg>
        Пн–Пт: 9:00–18:00, Сб: 10:00–15:00
      </div>
  </div>

</section>
