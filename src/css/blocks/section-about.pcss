.section-about {
  &::before {
    opacity: 0.8;
  }
  padding: 20px 10px;
  background-image: image-set(
    url('../media/images/bg-about.webp') type('image/webp'),
    url('../media/images/bg-about.jpg') type('image/jpeg')
  );
  background-position: center;
  background-size: cover;

  @media (min-width: $desktop) {
    background-image: image-set(
      url('../media/images/bg-about.webp') type('image/webp'),
      url('../media/images/bg-about.jpg') type('image/jpeg')
    );
  }

  .about-content {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;

    .about-title {
      margin-bottom: 15px;
      color: white;

      span {
        color: var(--red);
      }
    }

    .swiper-about {
      .swiper-slide-wrapper {
        display: flex;
        justify-content: center;

        img {
          object-fit: cover;
          width: 100%;
        }
      }

      .swiper-button-prev,
      .swiper-button-next {
        color: white;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }
    }

    .swiper-about:hover .swiper-button-prev,
    .swiper-about:hover .swiper-button-next {
      visibility: visible;
      opacity: 1;
    }

    .swiper-about .swiper-button-next svg {
      transform: rotate(180deg);
    }


    .about-spoiler-checkbox {
      display: none;
    }

    .about-spoiler-label {
      display: block;
      width: fit-content;
      margin: 10px auto 0;
      color: white;
      text-decoration: underline;
      cursor: pointer;

      svg {
        width: 30px;
        height: 19px;
        transform: rotate(-90deg);
        fill: white;
      }
    }

    .about-text-title {
      display: block;
      margin-top: 20px;
      color: white;
      text-align: center;
      text-shadow: 0 1px 3px rgb(0 0 0 / 0.9);
    }

    .about-text-content {
      max-width: 768px;
      max-height: 120px;
      margin: 0 auto;
      padding: 12px;
      overflow: hidden;
      color: white;
      line-height: 1.35;
      text-shadow: 0 1px 3px rgb(0 0 0 / 0.9);
      background-color: rgb(0 0 0 / 0.55);
      transition: max-height 0.3s ease;

      a {
        color: var(--red);
        font-weight: 700;
        text-decoration-thickness: 2px;
        text-underline-offset: 2px;

        &:hover,
        &:focus {
          color: white;
        }
      }

      @media (min-width: $tablet) {
        font-size: 18px;
      }
    }

    .about-spoiler-checkbox:checked ~ .about-text-content {
      max-height: 1000px;
    }

    .about-spoiler-checkbox:checked ~ .about-spoiler-label svg {
      transform: rotate(90deg);
    }
  }
}
